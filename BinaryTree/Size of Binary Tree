solution---
    class Solution {

    // Method to calculate the total number of nodes in a binary tree
    public static int getSize(Node root) {

        // Base case:
        // If the current node is null, the size contribution is 0
        if (root == null) {
            return 0;
        }

        // Recursively calculate the number of nodes in the left subtree
        int leftSubtreeSize = getSize(root.left);

        // Recursively calculate the number of nodes in the right subtree
        int rightSubtreeSize = getSize(root.right);

        // Total size = nodes in left subtree + nodes in right subtree + current node
        return leftSubtreeSize + rightSubtreeSize + 1;
    }
}
